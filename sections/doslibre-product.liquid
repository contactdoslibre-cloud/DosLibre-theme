<script>
var dlUp = {{ product.price }};
function dlFmt(c){return(c/100).toFixed(2).replace('.',',')+' €';}
document.addEventListener('DOMContentLoaded',function(){
  var p2=dlFmt(Math.round(dlUp*2*0.83));
  var p3=dlFmt(Math.round(dlUp*3*0.72));
  var e2=document.getElementById('dl-p2');
  var e3=document.getElementById('dl-p3');
  if(e2)e2.textContent=p2;
  if(e3)e3.textContent=p3;
  var ctaEl=document.getElementById('dl-cta-p');
  if(ctaEl)ctaEl.textContent=p2;
  var spEl=document.getElementById('dl-sp');
  if(spEl)spEl.textContent=p2;
});
function dlBundle(card,qty){
  document.querySelectorAll('.dl-bc').forEach(function(c){
    c.classList.remove('on');
    var r=c.querySelector('.dl-radio');
    if(r){r.style.borderColor='';r.style.background='';r.style.boxShadow='';}
  });
  card.classList.add('on');
  var radio=card.querySelector('.dl-radio');
  if(radio){radio.style.borderColor='#1D9E75';radio.style.background='#1D9E75';radio.style.boxShadow='inset 0 0 0 3px #fff';}
  var qtyEl=document.getElementById('dl-qty');
  if(qtyEl)qtyEl.value=qty;
  var disc={1:1.0,2:0.83,3:0.72};
  var total=dlFmt(Math.round(dlUp*qty*disc[qty]));
  var cp=document.getElementById('dl-cta-p');
  if(cp)cp.textContent=total;
  var labels={1:'1 appareil',2:'2 appareils',3:'3 appareils'};
  var sq=document.getElementById('dl-sqty');
  var sp=document.getElementById('dl-sp');
  if(sq)sq.textContent=labels[qty];
  if(sp)sp.textContent=total;
}
function dlImg(url,thumb){
  var img=document.getElementById('dl-main-photo');
  if(img)img.src=url;
  document.querySelectorAll('.dl-thumb').forEach(function(x){x.classList.remove('active');});
  thumb.classList.add('active');
}
</script>
