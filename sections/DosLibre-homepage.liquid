<style>
.dlh * { box-sizing: border-box; margin: 0; padding: 0; }
.dlh {
  --g: #1D9E75; --gd: #178A64; --gbg: #EDF7F3; --gr: #666;
  font-family: 'Nunito Sans', sans-serif;
  color: #111; background: #fff; overflow-x: hidden;
}
.dlh-ann { background: var(--g); text-align: center; padding: 10px; font-size: 13px; color: #fff; font-weight: 500; }
.dlh-hero { display: grid; grid-template-columns: 1fr 1fr; align-items: center; max-width: 1200px; margin: 0 auto; padding: 70px 40px; gap: 60px; min-height: 90vh; }
.dlh-pretitle { display: inline-flex; align-items: center; gap: 8px; background: var(--gbg); color: var(--g); font-size: 12px; font-weight: 700; padding: 6px 14px; border-radius: 50px; margin-bottom: 24px; letter-spacing: .5px; }
.dlh-dot { width: 8px; height: 8px; background: var(--g); border-radius: 50%; animation: dlh-blink 2s infinite; }
@keyframes dlh-blink { 0%,100%{opacity:1;} 50%{opacity:.3;} }
.dlh-hero h1 { font-family: 'Outfit', sans-serif; font-size: 54px; font-weight: 900; line-height: 1.05; margin-bottom: 20px; }
.dlh-hero h1 em { color: var(--g); font-style: normal; }
.dlh-sub { font-size: 16px; color: var(--gr); line-height: 1.7; margin-bottom: 36px; max-width: 460px; }
.dlh-btns { display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 36px; }
.dlh-btn { display: inline-flex; align-items: center; gap: 8px; background: var(--g); color: #fff; padding: 16px 32px; border-radius: 50px; font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 15px; text-decoration: none; transition: background .2s, transform .15s; }
.dlh-btn:hover { background: var(--gd); transform: translateY(-2px); }
.dlh-btn-o { display: inline-flex; align-items: center; gap: 8px; background: transparent; color: #111; padding: 16px 28px; border-radius: 50px; font-family: 'Outfit', sans-serif; font-weight: 600; font-size: 15px; text-decoration: none; border: 2px solid #E0EDE8; transition: border-color .2s; }
.dlh-btn-o:hover { border-color: var(--g); }
.dlh-pills { display: flex; gap: 12px; flex-wrap: wrap; }
.dlh-pill { font-size: 12px; color: var(--gr); font-weight: 500; display: flex; align-items: center; gap: 5px; }
.dlh-pill::before { content: "‚úì"; color: var(--g); font-weight: 700; }
.dlh-hero-img { position: relative; }
.dlh-hero-card { border-radius: 32px; overflow: hidden; height: 560px; position: relative; }
.dlh-hero-card img { width: 100%; height: 100%; object-fit: cover; }
.dlh-hero-card::after { content: ''; position: absolute; inset: 0; background: linear-gradient(135deg, rgba(29,158,117,.15) 0%, transparent 60%); }
.dlh-badge-float { position: absolute; background: #fff; border-radius: 16px; padding: 12px 16px; box-shadow: 0 8px 30px rgba(0,0,0,.12); z-index: 2; }
.dlh-badge-float.tl { top: 24px; left: -16px; }
.dlh-badge-float.br { bottom: 32px; right: -16px; }
.dlh-bt { font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 14px; }
.dlh-bs { font-size: 11px; color: var(--gr); margin-top: 2px; }
.dlh-ss { color: var(--g); font-size: 12px; margin-bottom: 2px; }
.dlh-ticker-wrap { overflow: hidden; background: #111; padding: 12px 0; }
.dlh-ticker { display: flex; gap: 48px; white-space: nowrap; animation: dlh-tick 22s linear infinite; }
.dlh-ticker span { font-size: 13px; color: #fff; font-weight: 500; }
.dlh-ticker span::before { content: "‚òÖ  "; color: var(--g); }
@keyframes dlh-tick { from{transform:translateX(0);} to{transform:translateX(-50%);} }
.dlh-sec { padding: 80px 40px; }
.dlh-sec.bg { background: var(--gbg); }
.dlh-cnt { max-width: 1100px; margin: 0 auto; }
.dlh-h2 { font-family: 'Outfit', sans-serif; text-align: center; font-size: 36px; font-weight: 800; margin-bottom: 12px; }
.dlh-h2 em { color: var(--g); font-style: normal; }
.dlh-h2-sub { text-align: center; color: var(--gr); font-size: 15px; margin-bottom: 52px; }
.dlh-feats { display: grid; grid-template-columns: repeat(3,1fr); gap: 24px; }
.dlh-feat { background: #fff; border: 1.5px solid #E8F5F0; border-radius: 20px; padding: 28px 22px; transition: transform .2s, box-shadow .2s; }
.dlh-feat:hover { transform: translateY(-4px); box-shadow: 0 12px 40px rgba(29,158,117,.1); }
.dlh-feat-ico { font-size: 28px; margin-bottom: 14px; }
.dlh-feat h3 { font-family: 'Outfit', sans-serif; font-size: 16px; font-weight: 700; margin-bottom: 8px; }
.dlh-feat p { font-size: 13px; color: var(--gr); line-height: 1.6; }
.dlh-gallery { display: grid; grid-template-columns: 2fr 1fr 1fr; grid-template-rows: 1fr 1fr; gap: 16px; height: 520px; }
.dlh-gal { border-radius: 20px; overflow: hidden; }
.dlh-gal img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s; }
.dlh-gal:hover img { transform: scale(1.04); }
.dlh-gal:first-child { grid-row: 1 / 3; }
.dlh-steps { display: grid; grid-template-columns: repeat(4,1fr); gap: 24px; position: relative; }
.dlh-steps::before { content: ''; position: absolute; top: 28px; left: 12%; right: 12%; height: 2px; background: linear-gradient(90deg, var(--g), var(--gbg)); }
.dlh-step { text-align: center; position: relative; z-index: 1; }
.dlh-step-n { width: 56px; height: 56px; background: var(--g); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: 'Outfit', sans-serif; font-weight: 800; font-size: 18px; color: #fff; margin: 0 auto 14px; border: 4px solid #fff; box-shadow: 0 0 0 2px var(--g); }
.dlh-step h4 { font-family: 'Outfit', sans-serif; font-size: 14px; font-weight: 700; margin-bottom: 6px; }
.dlh-step p { font-size: 12px; color: var(--gr); line-height: 1.5; }
.dlh-prod { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
.dlh-prod-img { border-radius: 24px; overflow: hidden; height: 480px; }
.dlh-prod-img img { width: 100%; height: 100%; object-fit: cover; }
.dlh-prod h2 { font-family: 'Outfit', sans-serif; font-size: 36px; font-weight: 800; line-height: 1.1; margin-bottom: 16px; }
.dlh-prod h2 em { color: var(--g); font-style: italic; }
.dlh-prod-txt p { font-size: 15px; color: var(--gr); line-height: 1.7; margin-bottom: 24px; }
.dlh-pts { margin-bottom: 28px; }
.dlh-pt { display: flex; align-items: flex-start; gap: 10px; margin-bottom: 10px; font-size: 14px; }
.dlh-pt::before { content: "‚úì"; color: var(--g); font-weight: 700; flex-shrink: 0; }
.dlh-price-lbl { font-family: 'Outfit', sans-serif; font-size: 13px; color: var(--gr); margin-bottom: 4px; }
.dlh-price-val { font-family: 'Outfit', sans-serif; font-size: 36px; font-weight: 900; color: var(--g); margin-bottom: 20px; }
.dlh-revs { display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; }
.dlh-rev { background: #fff; border: 1.5px solid #E8F5F0; border-radius: 16px; padding: 20px; }
.dlh-rev-h { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }
.dlh-av { width: 38px; height: 38px; background: var(--g); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 14px; flex-shrink: 0; }
.dlh-rev-n { font-weight: 700; font-size: 13px; }
.dlh-rev-s { color: var(--g); font-size: 11px; }
.dlh-rev p { font-size: 13px; color: var(--gr); line-height: 1.6; }
.dlh-cta-ban { background: var(--g); padding: 80px 40px; text-align: center; }
.dlh-cta-ban h2 { font-family: 'Outfit', sans-serif; font-size: 40px; font-weight: 900; color: #fff; margin-bottom: 14px; line-height: 1.1; }
.dlh-cta-ban p { font-size: 16px; color: rgba(255,255,255,.8); margin-bottom: 32px; }
.dlh-btn-w { display: inline-flex; align-items: center; gap: 8px; background: #fff; color: var(--g); padding: 18px 40px; border-radius: 50px; font-family: 'Outfit', sans-serif; font-weight: 800; font-size: 16px; text-decoration: none; transition: transform .2s, box-shadow .2s; }
.dlh-btn-w:hover { transform: translateY(-2px); box-shadow: 0 8px 30px rgba(0,0,0,.2); }
.dlh-cta-trust { display: flex; gap: 24px; justify-content: center; margin-top: 20px; flex-wrap: wrap; }
.dlh-cta-trust span { font-size: 13px; color: rgba(255,255,255,.75); }
.dlh-cta-trust span::before { content: "‚úì "; }
.dlh-foot { background: #F7FAF9; padding: 48px 40px 24px; border-top: 1px solid #E0EDE8; }
.dlh-foot-grid { max-width: 1100px; margin: 0 auto 36px; display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 40px; }
.dlh-foot-tag { font-size: 13px; color: var(--gr); line-height: 1.6; max-width: 240px; margin-top: 10px; }
.dlh-foot-col h5 { font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 14px; margin-bottom: 14px; }
.dlh-foot-col a { display: block; font-size: 13px; color: var(--gr); text-decoration: none; margin-bottom: 8px; }
.dlh-foot-col a:hover { color: var(--g); }
.dlh-foot-bot { max-width: 1100px; margin: 0 auto; text-align: center; font-size: 12px; color: var(--gr); border-top: 1px solid #E0EDE8; padding-top: 20px; }
@media (max-width: 768px) {
  .dlh-hero { grid-template-columns: 1fr; padding: 32px 20px; min-height: auto; gap: 32px; }
  .dlh-hero h1 { font-size: 34px; }
  .dlh-feats, .dlh-revs { grid-template-columns: 1fr; }
  .dlh-steps { grid-template-columns: 1fr 1fr; }
  .dlh-steps::before { display: none; }
  .dlh-prod { grid-template-columns: 1fr; }
  .dlh-gallery { grid-template-columns: 1fr 1fr; grid-template-rows: auto; height: auto; }
  .dlh-gal:first-child { grid-row: auto; }
  .dlh-foot-grid { grid-template-columns: 1fr 1fr; }
  .dlh-sec { padding: 56px 20px; }
  .dlh-h2 { font-size: 26px; }
  .dlh-badge-float { display: none; }
}
</style>

